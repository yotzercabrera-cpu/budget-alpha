---
import Layout from '../layouts/Layout.astro';
import ListingCard from '../components/ListingCard.astro';
import { site } from '../data/site';
import { compareListings } from '../lib/listings';
import { getCollection } from 'astro:content';

const listings = (await getCollection('listings')).sort(compareListings);
const newsletters = listings.filter(
  (item) => item.data.category === 'newsletter' || item.data.category === 'both',
).length;
const tools = listings.filter(
  (item) => item.data.category === 'tool' || item.data.category === 'both',
).length;
---

<Layout>
  <section class="hero wrap">
    <p class="kicker">Investing research · hard price cap</p>
    <h1>{site.tagline}</h1>
    <p class="lede">
      {site.name} is a small directory of newsletters and tools whose reviewed retail plan is
      ≤ ${site.priceCapMonthly}/month or ≤ about ${site.priceCapAnnual}/year. Intro teases do not
      count unless renewal also clears the cap. We do not invent performance claims.
    </p>
    <div class="rule-banner">
      <span class="pill">{listings.length} listings in this build</span>
      <span class="pill">Newsletters {newsletters}</span>
      <span class="pill">Tools {tools}</span>
      <span class="pill">Reviewed {site.lastReviewedLabel}</span>
    </div>
  </section>

  <section class="wrap" aria-labelledby="directory-heading">
    <h2 id="directory-heading" class="visually-hidden">Directory</h2>
    <div class="toolbar">
      <div class="filters" role="group" aria-label="Filter listings">
        <button type="button" data-filter="all" aria-pressed="true">All</button>
        <button type="button" data-filter="newsletters" aria-pressed="false">Newsletters</button>
        <button type="button" data-filter="tools" aria-pressed="false">Tools</button>
      </div>
      <label class="search">
        <span class="visually-hidden">Search listings</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"></circle>
          <path d="M20 20L16.5 16.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
        </svg>
        <input id="listing-search" type="search" placeholder="Search names, tags, jobs…" />
      </label>
    </div>

    <div class="listing-grid" id="listing-grid">
      {listings.map((listing) => <ListingCard listing={listing} />)}
      <p class="empty" id="listing-empty" hidden>No listings match that filter and search.</p>
    </div>
  </section>
</Layout>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const search = document.querySelector<HTMLInputElement>('#listing-search');
  const cards = document.querySelectorAll<HTMLAnchorElement>('.card[data-category]');
  const empty = document.querySelector<HTMLElement>('#listing-empty');
  let filter = 'all';

  function matchesFilter(category: string, selected: string) {
    if (selected === 'all') return true;
    if (selected === 'newsletters') return category === 'newsletter' || category === 'both';
    return category === 'tool' || category === 'both';
  }

  function apply() {
    const query = (search?.value ?? '').trim().toLowerCase();
    let visible = 0;
    for (const card of cards) {
      const category = card.dataset.category ?? '';
      const haystack = card.dataset.search ?? '';
      const show = matchesFilter(category, filter) && (!query || haystack.includes(query));
      card.toggleAttribute('hidden', !show);
      card.style.display = show ? '' : 'none';
      if (show) visible += 1;
    }
    if (empty) {
      empty.hidden = visible !== 0;
      empty.style.display = visible === 0 ? 'block' : 'none';
    }
  }

  for (const button of buttons) {
    button.addEventListener('click', () => {
      filter = button.dataset.filter ?? 'all';
      for (const other of buttons) {
        other.setAttribute('aria-pressed', String(other === button));
      }
      apply();
    });
  }

  search?.addEventListener('input', apply);
</script>
